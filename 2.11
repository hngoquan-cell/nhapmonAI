      ],
      "source": [
        "import numpy as np\n",
        "!pip install fuzzy scikit-fuzzy\n",
        "import skfuzzy as fuzz\n",
        "from skfuzzy import control as ctrl\n",
        "\n",
        "distance = ctrl.Antecedent(np.arange(0, 50.1, 0.1), 'distance')\n",
        "traffic = ctrl.Antecedent(np.arange(0, 1.001, 0.001), 'traffic')\n",
        "wether = ctrl.Antecedent(np.arange(0, 10.1, 0.1), 'wether_severity')\n",
        "cus = ctrl.Antecedent(np.arange(1, 5.01, 0.01), 'cus')\n",
        "pun = ctrl.Antecedent(np.arange(0, 1.001, 0.001), 'pun')\n",
        "\n",
        "de_lever = ctrl.Antecedent(np.arange(0, 1.001, 0.001), 'de_lever')\n",
        "\n",
        "#dau ra\n",
        "money = ctrl.Consequent(np.arange(0, 100.1, 0.1), 'money')\n",
        "reward = ctrl.Consequent(np.arange(0, 10.1, 0.1), 'reward')\n",
        "\n",
        "\n",
        "\n",
        "# Distance\n",
        "distance['short'] = fuzz.trimf(distance.universe, [0, 3, 3])\n",
        "distance['medium'] = fuzz.trimf(distance.universe, [2, 8, 8])\n",
        "distance['long'] = fuzz.trimf(distance.universe, [6, 20, 20])\n",
        "distance['v_long'] = fuzz.trimf(distance.universe, [15, 50, 50])\n",
        "\n",
        "# Traffic\n",
        "traffic['low'] = fuzz.trimf(traffic.universe, [0, 0, 0.3])\n",
        "traffic['medium'] = fuzz.trimf(traffic.universe, [0.2, 0.45,   0.7])\n",
        "traffic['high'] = fuzz.trimf(traffic.universe, [0.6, 1, 1])\n",
        "\n",
        "# Delivery Level\n",
        "de_lever['low'] = fuzz.trimf(de_lever.universe, [0, 0, 0.3])\n",
        "de_lever['medium'] = fuzz.trimf(de_lever.universe, [0.2, 0.45, 0.7])\n",
        "de_lever['high'] = fuzz.trimf(de_lever.universe, [0.6, 1, 1])\n",
        "\n",
        "# Weather\n",
        "wether['good'] = fuzz.trimf(wether.universe, [0, 0, 4])\n",
        "wether['light'] = fuzz.trimf(wether.universe, [0, 5, 10])\n",
        "wether['storm'] = fuzz.trimf(wether.universe, [6, 10, 10])\n",
        "\n",
        "# Customer Rating\n",
        "cus['poor'] = fuzz.trimf(cus.universe, [1, 1, 2.5])\n",
        "cus['average'] = fuzz.trimf(cus.universe, [2, 3, 4])\n",
        "cus['good'] = fuzz.trimf(cus.universe, [3.5, 5, 5])\n",
        "\n",
        "# Punctuality\n",
        "pun['late'] = fuzz.trimf(pun.universe, [0, 0, 0.5])\n",
        "pun['on time'] = fuzz.trimf(pun.universe, [0.4, 0.6, 0.8])\n",
        "pun['early'] = fuzz.trimf(pun.universe, [0.7, 1, 1])\n",
        "\n",
        "# Money (Output)\n",
        "money['low'] = fuzz.trimf(money.universe, [0, 0, 30])\n",
        "money['medium'] = fuzz.trimf(money.universe, [20, 50, 80])\n",
        "money['high'] = fuzz.trimf(money.universe, [50, 70, 90])\n",
        "money['v_high'] = fuzz.trimf(money.universe, [80, 100, 100])\n",
        "\n",
        "# Reward (Output)\n",
        "reward['none'] = fuzz.trimf(reward.universe, [0, 0, 3])\n",
        "reward['few'] = fuzz.trimf(reward.universe, [2, 5, 8])\n",
        "reward['moderate'] = fuzz.trimf(reward.universe, [5, 7, 9])\n",
        "reward['high'] = fuzz.trimf(reward.universe, [8, 10, 10])\n",
        "\n",
        "\n",
        "\n",
        "# Rules cho ma ni\n",
        "rules_money = [\n",
        "    ctrl.Rule(distance['short'] & traffic['low'] & de_lever['low'], money['low']),\n",
        "    ctrl.Rule(distance['short'] & traffic['medium'] & de_lever['high'], money['medium']),\n",
        "    ctrl.Rule(distance['medium'] & traffic['high'] & de_lever['high'], money['high']),\n",
        "    ctrl.Rule(distance['long'] & traffic['medium'] & wether['good'], money['medium']),\n",
        "    ctrl.Rule(distance['v_long'] & traffic['high'] & wether['storm'], money['v_high']),\n",
        "    ctrl.Rule(distance['v_long'] & traffic['high'] & de_lever['high'], money['v_high']),\n",
        "    ctrl.Rule(distance['medium'] & traffic['low'] & de_lever['low'], money['medium']),\n",
        "ctrl.Rule(distance['short'] & traffic['high'] & wether['storm'], money['high']),\n",
        "    ctrl.Rule(distance['v_long'] & wether['storm'], money['v_high']),\n",
        "    ctrl.Rule(distance['medium'] & traffic['medium'] & wether['light'], money['medium'])\n",
        "]\n",
        "\n",
        "# Rules thuong\n",
        "rules_reward = [\n",
        "\n",
        "    ctrl.Rule(cus['good']&pun['on time'],reward['high']),\n",
        "    ctrl.Rule(cus['average']&pun['on time'],reward['moderate']),\n",
        "    ctrl.Rule(cus['poor'] & pun['late'],reward['none']),\n",
        "    ctrl.Rule(distance['long']&traffic['high']&pun['on time'],reward['high']),\n",
        "    ctrl.Rule(distance['medium']&traffic['medium']&cus['good'],reward['moderate']),\n",
        "    ctrl.Rule(cus['poor']&pun['late'],reward['none']), # Duplicate of rule13\n",
        "    ctrl.Rule(distance['v_long']&wether['storm']&cus['good'],reward['high']),\n",
        "    ctrl.Rule(distance['short'] & cus['average'] & pun['on time'],reward['few']),\n",
        "    ctrl.Rule(distance['long']&traffic['high']&pun['late'],reward['few']),\n",
        "    ctrl.Rule(distance['medium'] & cus['good'] & wether['light'],reward['moderate'])\n",
        "]\n",
        "\n",
        "\n",
        "money_ctrl = ctrl.ControlSystem(rules_money)\n",
        "sim_money = ctrl.ControlSystemSimulation(money_ctrl)\n",
        "\n",
        "reward_ctrl = ctrl.ControlSystem(rules_reward)\n",
        "sim_reward = ctrl.ControlSystemSimulation(reward_ctrl)\n",
        "\n",
        "\n",
        "# Giả sử 1 đơn hàng cụ thể\n",
        "sim_money.input['distance'] = 5.5\n",
        "sim_money.input['traffic'] = 3.6\n",
        "sim_money.input['wether_severity'] = 9.0\n",
        "sim_money.input['de_lever'] = 2\n",
        "sim_money.compute()\n",
        "\n",
        "sim_reward.input['distance'] = 21.0\n",
        "sim_reward.input['traffic'] = 1.5\n",
        "sim_reward.input['wether_severity'] = 8.5\n",
        "sim_reward.input['cus'] = 4.7\n",
        "sim_reward.input['pun'] = 0.9\n",
        "sim_reward.compute()\n",
        "\n",
        "# In kết quả\n",
        "print(f\"--- KẾT QUẢ ---\")\n",
        "print(f\"Số tiền khách phải trả: {sim_money.output['money']:.2f}\")\n",
        "print(f\"Số tiền thưởng tài xế: {sim_reward.output['reward']:.2f}\")\n",
        "\n",
        "distance.view()\n",
        "traffic.view()\n",
        "de_lever.view()\n",
        "wether.view()\n",
        "cus.view()\n",
        "pun.view()\n",
        "money.view()\n",
        "reward.view()"
      ]
    }
  ]
}