      "source": [
        "!pip install fuzzy scikit-fuzzy\n",
        "import numpy as np\n",
        "import skfuzzy as fuzz\n",
        "from skfuzzy import control as ctrl\n",
        "\n",
        "#dau vao Antecedent\n",
        "uy_tin = ctrl.Antecedent(np.arange(0, 5.1, 0.1), 'uy_tin')\n",
        "khoi_luong_ban = ctrl.Antecedent(np.arange(0, 1001, 1), 'khoi_luong')\n",
        "bien_loi_nhuan = ctrl.Antecedent(np.arange(0, 101, 1), 'loi_nhuan')\n",
        "mua_vu = ctrl.Antecedent(np.arange(0, 11, 1), 'mua_vu')\n",
        "doi_thu = ctrl.Antecedent(np.arange(0, 101, 1), 'doi_thu')\n",
        "\n",
        "#dau ra Consequent\n",
        "chiet_khau = ctrl.Consequent(np.arange(0, 70.1, 0.1), 'chiet_khau')\n",
        "\n",
        "\n",
        "uy_tin['thap'] = fuzz.trimf(uy_tin.universe, [0, 0, 4.0])\n",
        "uy_tin['trung_binh'] = fuzz.trimf(uy_tin.universe, [4.0, 4.2, 4.5])\n",
        "uy_tin['cao'] = fuzz.trimf(uy_tin.universe, [4.5, 5.0, 5.0])\n",
        "\n",
        "khoi_luong_ban['thap'] = fuzz.trimf(khoi_luong_ban.universe, [0, 0, 400])\n",
        "khoi_luong_ban['trung_binh'] = fuzz.trimf(khoi_luong_ban.universe, [300, 500, 700])\n",
        "khoi_luong_ban['cao'] = fuzz.trimf(khoi_luong_ban.universe, [600, 1000, 1000])\n",
        "\n",
        "bien_loi_nhuan['thap'] = fuzz.trimf(bien_loi_nhuan.universe, [0, 0, 30])\n",
        "bien_loi_nhuan['trung_binh'] = fuzz.trimf(bien_loi_nhuan.universe, [20, 50, 70])\n",
        "bien_loi_nhuan['cao'] = fuzz.trimf(bien_loi_nhuan.universe, [60, 100, 100])\n",
        "\n",
        "mua_vu['none'] = fuzz.trimf(mua_vu.universe, [0, 0, 4])\n",
        "mua_vu['trung_binh'] = fuzz.trimf(mua_vu.universe, [3, 5, 7])\n",
        "mua_vu['cao'] = fuzz.trimf(mua_vu.universe, [6, 10, 10])\n",
        "\n",
        "\n",
        "doi_thu['thap'] = fuzz.trimf(doi_thu.universe, [0, 0, 30])\n",
        "doi_thu['trung_binh'] = fuzz.trimf(doi_thu.universe, [20, 50, 70])\n",
        "doi_thu['cao'] = fuzz.trimf(doi_thu.universe, [60, 100, 100])\n",
        "\n",
        "\n",
        "chiet_khau['rat_thap'] = fuzz.trimf(chiet_khau.universe, [0, 2.5, 5])\n",
        "chiet_khau['thap'] = fuzz.trimf(chiet_khau.universe, [5, 7.5, 10])\n",
        "chiet_khau['trung_binh'] = fuzz.trimf(chiet_khau.universe, [10, 15, 20])\n",
        "chiet_khau['cao'] = fuzz.trimf(chiet_khau.universe, [20, 30, 40])\n",
        "chiet_khau['rat_cao'] = fuzz.trimf(chiet_khau.universe, [40, 55, 70])\n",
        "\n",
        "\n",
        "\n",
        "rules = [\n",
        "    ctrl.Rule(uy_tin['cao'] & khoi_luong_ban['cao'] & bien_loi_nhuan['cao'], chiet_khau['rat_thap']),\n",
        "    ctrl.Rule(uy_tin['thap'] & khoi_luong_ban['thap'] & bien_loi_nhuan['cao'], chiet_khau['cao']),\n",
        "    ctrl.Rule(mua_vu['cao'], chiet_khau['rat_cao']),\n",
        "    ctrl.Rule(uy_tin['thap'] & mua_vu['none'] , chiet_khau['trung_binh']),\n",
        "    ctrl.Rule(bien_loi_nhuan['cao'] & mua_vu['cao'], chiet_khau['trung_binh']),\n",
        "    ctrl.Rule(doi_thu['cao'] & mua_vu['trung_binh'], chiet_khau['cao']),\n",
        "    ctrl.Rule(khoi_luong_ban['thap'] & bien_loi_nhuan['thap'], chiet_khau['cao'])\n",
        "]\n",
        "\n",
        "\n",
        "discount_ctrl = ctrl.ControlSystem(rules)\n",
        "discount_sim = ctrl.ControlSystemSimulation(discount_ctrl)\n",
        "\n",
        "discount_sim.input['uy_tin'] = 4.3\n",
        "discount_sim.input['khoi_luong'] = 450\n",
        "discount_sim.input['loi_nhuan'] = 30\n",
        "discount_sim.input['mua_vu'] = 7\n",
        "discount_sim.input['doi_thu'] = 80\n",
        "\n",
        "\n",
        "discount_sim.compute()\n",
        "\n",
        "\n",
        "print(f\"--- KẾT QUẢ PHÂN TÍCH LOGIC MỜ ---\")\n",
        "print(f\"Mức chiết khấu đề xuất: {discount_sim.output['chiet_khau']:.2f}%\")\n",
        "\n",
        "uy_tin.view(sim=discount_sim)\n",
        "khoi_luong_ban.view(sim=discount_sim)\n",
        "bien_loi_nhuan.view(sim=discount_sim)\n",
        "mua_vu.view(sim=discount_sim)\n",
        "doi_thu.view(sim=discount_sim)"
      ]
    }
  ]
}