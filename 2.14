      "source": [
        "<a href=\"https://colab.research.google.com/github/hngoquan-cell/nhapmonAI/blob/main/2.14\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import skfuzzy as fuzzy\n",
        "from skfuzzy import control as ctrl\n",
        "#dau vao Antecedent\n",
        "mat_do = ctrl.Antecedent(np.arange(0, 11, 1), 'mat_do')\n",
        "khan_cap = ctrl.Antecedent(np.arange(0, 11, 1), 'khan_cap')\n",
        "tai_trong = ctrl.Antecedent(np.arange(0, 11, 1), 'tai_trong')\n",
        "giao_thong = ctrl.Antecedent(np.arange(0, 11, 1), 'giao_thong')\n",
        "loi_nhuan = ctrl.Antecedent(np.arange(0, 11, 1), 'loi_nhuan')\n",
        "\n",
        "# Đầu ra consequent\n",
        "ket_hop = ctrl.Consequent(np.arange(0, 11, 1), 'ket_hop')\n",
        "uu_tien = ctrl.Consequent(np.arange(0, 11, 1), 'uu_tien')\n",
        "\n",
        "\n",
        "cac_bien = [mat_do, khan_cap, tai_trong, giao_thong, loi_nhuan, ket_hop, uu_tien]\n",
        "for bien in cac_bien:\n",
        "    bien['thap']=fuzzy.trimf(bien.universe,[0,0,5])\n",
        "    bien['trungbinh']=fuzzy.trimf(bien.universe,[0,5,10])\n",
        "    bien['cao']=fuzzy.trimf(bien.universe,[5,10,10])\n",
        "\n",
        "rules = [\n",
        "    #rules ket hop\n",
        "    ctrl.Rule(mat_do['cao'] & tai_trong['thap'] & giao_thong['thap'], ket_hop['cao']),\n",
        "    ctrl.Rule(mat_do['trungbinh'] & giao_thong['cao'] & khan_cap['trungbinh'], ket_hop['trungbinh']),\n",
        "    ctrl.Rule(tai_trong['cao'] & mat_do['cao'] & loi_nhuan['trungbinh'], ket_hop['trungbinh']),\n",
        "    ctrl.Rule(mat_do['thap'] & khan_cap['cao'] & giao_thong['trungbinh'], ket_hop['trungbinh']),\n",
        "    ctrl.Rule(loi_nhuan['cao'] & khan_cap['cao'] & giao_thong['cao'], ket_hop['trungbinh']),\n",
        "    ctrl.Rule(mat_do['cao'] & giao_thong['trungbinh'] & khan_cap['trungbinh'], ket_hop['trungbinh']),\n",
        "\n",
        "#rules uatien\n",
        "    ctrl.Rule(khan_cap['cao'] & loi_nhuan['cao'], uu_tien['cao']),\n",
        "    ctrl.Rule(khan_cap['trungbinh'] & giao_thong['trungbinh'], uu_tien['trungbinh']),\n",
        "    ctrl.Rule(khan_cap['thap'] & mat_do['cao'] & loi_nhuan['thap'], uu_tien['thap']),\n",
        "    ctrl.Rule(giao_thong['trungbinh'] & loi_nhuan['trungbinh'] & tai_trong['thap'], uu_tien['trungbinh'])\n",
        "\n",
        "\n",
        "]\n",
        "\n",
        "rules_ctrl = ctrl.ControlSystem(rules)\n",
        "mo_phong = ctrl.ControlSystemSimulation(rules_ctrl)\n",
        "\n",
        "\n",
        "mo_phong.input['mat_do'] = 9\n",
        "mo_phong.input['khan_cap'] = 5\n",
        "mo_phong.input['tai_trong'] = 2\n",
        "mo_phong.input['giao_thong'] = 5\n",
        "mo_phong.input['loi_nhuan'] = 5\n",
        "\n",
        "mo_phong.compute()\n",
        "\n",
        "\n",
        "diem_ket_hop = mo_phong.output['ket_hop']\n",
        "diem_uu_tien = mo_phong.output['uu_tien']\n",
        "\n",
        "print(f\"Chỉ số kết hợp đơn hàng: {diem_ket_hop:.2f} / 10\")\n",
        "print(f\"Chỉ số ưu tiên giao hàng: {diem_uu_tien:.2f} / 10\")\n",
        "\n",
        "mat_do.view(sim=mo_phong)\n",
        "khan_cap.view(sim=mo_phong)\n",
        "tai_trong.view(sim=mo_phong)\n",
        "giao_thong.view(sim=mo_phong)\n",
        "loi_nhuan.view(sim=mo_phong)"
      ],
